{
  "name": "drift",
  "version": "1.3.0",
  "description": "Drift \u2014 a fast, cross-platform browser with a streamlined tab strip, persistent bookmarks, privacy protection, downloads, Chrome-compatible extensions, history, configurable settings, color themes, and context menus.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Drift contributors",
  "scripts": {
    "start": "electron .",
    "css:build": "tailwindcss -c tailwind.config.cjs -i ./src/renderer/shared/tailwind.css -o ./src/renderer/shared/tailwind.generated.css --minify",
    "predist": "npm run css:build",
    "dist": "electron-builder",
    "dist:win": "npm run css:build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "latest",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "org.drift.browser",
    "productName": "Drift",
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Drift-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Drift",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
