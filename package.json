{
  "name": "drift",
  "version": "1.3.9",
  "description": "Drift \u2014 a fast, cross-platform browser with a streamlined tab strip, persistent bookmarks, privacy protection, downloads, Chrome-compatible extensions, history, configurable settings, color themes, and context menus.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Jessie Albert Regualos (Yotsuchi)"
  },
  "scripts": {
    "start": "electron .",
    "css:build": "tailwindcss -c tailwind.config.cjs -i ./src/renderer/shared/tailwind.css -o ./src/renderer/shared/tailwind.generated.css --minify",
    "predist": "npm run css:build",
    "dist": "electron-builder",
    "dist:win": "npm run css:build && electron-builder --config electron-builder.setup.json --win portable --x64 --publish never",
    "icons:build": "node scripts/build_icons.cjs",
    "check": "node scripts/check-project.cjs",
    "test:updater": "node scripts/test-updater.cjs",
    "test:telemetry": "node scripts/test-telemetry.cjs",
    "test:gateway": "node scripts/test-gateway.cjs",
    "test:memory": "node scripts/test-memory.cjs",
    "test:storage": "node scripts/test-storage.cjs",
    "test": "npm run test:updater && npm run test:telemetry && npm run test:reviews && npm run test:review-prompt && npm run test:gateway && npm run test:memory && npm run test:storage && npm run test:appearance",
    "build:installer": "node scripts/build-installer.cjs",
    "test:reviews": "node scripts/test-reviews.cjs",
    "test:review-prompt": "node scripts/test-review-prompt.cjs",
    "test:appearance": "node scripts/test-appearance-settings.cjs"
  },
  "dependencies": {
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "latest",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "org.drift.browser",
    "productName": "Drift",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "build/icon.svg",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Drift-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    }
  }
}
